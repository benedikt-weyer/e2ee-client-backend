{
  "name": "e2ee-client-backend",
  "version": "0.1.0",
  "description": "Browser-first E2EE client backend with repository, adapter, cache, and crypto strategy abstractions.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "lokijs": "^1.5.12",
    "mlkem-wasm": "^0.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lokijs": "^1.5.14",
    "@types/node": "^20",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}